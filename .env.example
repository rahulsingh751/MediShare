DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-reply@medishare.local
# Leave disabled unless testing a controlled local workflow or after external approval.
MEDISHARE_REQUEST_WORKFLOWS_ENABLED=false

# Gmail SMTP example. Use a Google App Password, not your account password.
# The account must have 2-Step Verification enabled to create an App Password.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.gmail.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=your-address@gmail.com
# DJANGO_EMAIL_HOST_PASSWORD=your-16-character-app-password
# DJANGO_EMAIL_USE_TLS=true
# DJANGO_DEFAULT_FROM_EMAIL=your-address@gmail.com

# Optional PostgreSQL settings. SQLite is used when DB_ENGINE is omitted.
# DB_ENGINE=postgresql
# DB_NAME=medishare
# DB_USER=medishare
# DB_PASSWORD=change-me
# DB_HOST=127.0.0.1
# DB_PORT=5432
